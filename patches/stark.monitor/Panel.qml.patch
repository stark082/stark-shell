 import qs.Commons
 import qs.Commons as Commons
 import "Model.js" as Model
+import "../stark.bar/menu-bridge" as Integration
 
 Panel {
   id: root
+
+  readonly property string embeddedKind: "monitor"
+  readonly property bool embedded: Integration.Bridge.host !== null && Integration.Bridge.host.bar.position === "top"
+  readonly property real embeddedWidth: panel.contentWidth
+  readonly property real embeddedHeight: panel.contentHeight
+  property Item originalContentParent: null
+  Binding {
+    target: panel.loadedContent
+    property: "visible"
+    value: root.opened
+    when: root.embedded && panel.loadedContent !== null
+  }
+  function open() {
+    Integration.Bridge.selectHost()
+    if (!root.embedded && originalContentParent && panel.loadedContent)
+      panel.loadedContent.parent = originalContentParent
+    root.controller.show()
+  }
+  function close() { root.controller.hide() }
+  function syncEmbedded() {
+    if (!root.opened || !root.embedded) return
+    panel.ensureContent()
+    var content = panel.loadedContent
+    if (!content) return
+    if (!originalContentParent) originalContentParent = content.parent
+    var host = Integration.Bridge.host
+    host.openExtra(root)
+    content.parent = host.extraSurface
+    Qt.callLater(function(){ if (root.opened) content.forceActiveFocus() })
+  }
   moduleName: "omarchy.monitor"
   ipcTarget: "omarchy.monitor"
   manageIpc: false
